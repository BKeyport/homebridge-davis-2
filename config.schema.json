{
  "pluginAlias": "Davis2",
  "pluginType": "platform",
  "singular": false,

  "headerDisplay": "Homebridge-Davis-2",

  "schema": {
    "type": "object",

    "properties": {
      "name": {
         "title": "Platform Name",
         "type": "string",
         "default": "Davis Weather"
    },
  
      "url": {
        "title": "Davis Local API URL",
        "type": "string",
        "description": "Example: http://1.2.3.4/v1/current_conditions",
	"default": "http://1.2.3.4/v1/current_conditions"
      },

      "pollingIntervalSeconds": {
        "title": "Polling Interval (seconds)",
        "type": "integer",
        "default": 60,
        "minimum": 10
      },

      "staleAfterMinutes": {
        "title": "Stale Threshold (minutes)",
        "type": "integer",
        "default": 5,
        "minimum": 1
      },

      "inputTemperatureUnit": {
        "title": "Sensor Temperature Unit",
        "type": "string",
        "description": "What unit comes off the sensor? (If values seem wrong, try the other one)",
        "enum": [
          "F",
          "C"
        ]
      },

      "txids": {
        "title": "Allowed TXIDs (Default is ID 1 only)",
        "type": "array",
        "items": {
          "type": "integer"
        },
        "default": [
          1
        ]
      },

      "enableExternalSensors": {
        "title": "Enable External Sensors (including Airlink's temperature and humidity)",
        "type": "boolean",
        "default": false
      },

      "enableInternalSensors": {
        "title": "Enable Internal Sensors",
        "type": "boolean",
        "default": false
      },

      "enableAirLink": {
        "title": "Enable AirLink Air Quality sensors",
        "type": "boolean",
        "default": false
      },

      "verboseLogging": {
        "title": "Enable detailed Debug Logging (Show data dumps)",
        "type": "boolean",
        "default": false
      }

    },

    "required": [
      "url",
      "inputTemperatureUnit",
      "staleAfterMinutes"
    ]
  }
}
